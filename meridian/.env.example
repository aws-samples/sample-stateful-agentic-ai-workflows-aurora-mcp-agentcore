# Copy to .env and fill in your values. Never commit .env.
# AWS auth: use `aws configure`, an IAM role, or env vars below (optional).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Bedrock — LLM identifier used by every Strands agent (phases 1–5).
# Default is GPT-6 Sol on Amazon Bedrock, the fastest model that stayed
# accurate in the demo's latency tests. If you see "ValidationException: The
# provided model identifier is invalid" at runtime, switch to a profile your
# account has access to.
# Run `aws bedrock list-inference-profiles --region us-east-1` to see what's
# available, e.g.:
#   us.openai.gpt-6-sol                                 # default: fastest accurate replies
#   us.openai.gpt-6-luna                                # also fast, a little less consistent
#   global.anthropic.claude-sonnet-5-5                  # more nuanced, a few seconds slower
#   global.anthropic.claude-haiku-4-5-20251001-v1:0    # cheapest
BEDROCK_MODEL_ID=us.openai.gpt-6-sol
BEDROCK_REGION=us-east-1

# Embeddings (Cohere Embed v4 — 1024d for Aurora pgvector)
EMBEDDING_MODEL=cohere.embed-v4:0
EMBEDDING_DIMENSION=1024

# Reranking (Phase 3). The bare model ID is what Bedrock actually serves in
# us-east-1 (confirmed via GetFoundationModel: ACTIVE, ON_DEMAND). There is
# no us.cohere.rerank-v3-5:0 cross-Region inference profile - that ID
# returns ResourceNotFoundException. Override only if your region needs a
# different ID.
# RERANK_MODEL=cohere.rerank-v3-5:0

# Aurora PostgreSQL (RDS Data API)
AURORA_HOST=your_cluster_endpoint
AURORA_PORT=5432
AURORA_DATABASE=meridian
AURORA_USERNAME=meridian_admin
AURORA_CLUSTER_ARN=arn:aws:rds:region:account-id:cluster:your-cluster
AURORA_SECRET_ARN=arn:aws:secretsmanager:region:account-id:secret:your-secret
# Least-privilege workflow login (meridian_workflow), written by
# scripts/provision_workflow_login.py --write-env. The master secret above stays admin-only.
AURORA_WORKFLOW_SECRET_ARN=
# Least-privilege logins for the backend (meridian_backend), the gateway Lambdas
# (meridian_gateway) and the Cognito sign-in trigger (meridian_identity), written by
# scripts/provision_service_logins.py --write-env. Each is prepared before it is used:
# the hosted backend and the Lambdas keep the master secret above until the cutover release.
AURORA_BACKEND_SECRET_ARN=
AURORA_GATEWAY_SECRET_ARN=
AURORA_IDENTITY_SECRET_ARN=
AURORA_CLUSTER_IDENTIFIER=your_cluster_identifier
AURORA_CLUSTER_ENDPOINT=your_cluster_endpoint
# Accepted alias for the writer endpoint, read by the pooled psycopg path.
# AURORA_DATABASE_ENDPOINT=your_cluster_endpoint
# Only needed for the direct psycopg path (Phase 5 checkpoints). The RDS Data
# API path resolves credentials from AURORA_SECRET_ARN instead — prefer that.
# AURORA_PASSWORD=

# Connection pool (optional, direct psycopg use)
AURORA_MIN_POOL_SIZE=2
AURORA_MAX_POOL_SIZE=20
AURORA_POOL_TIMEOUT=30

# Row-Level Security (Phase 4) — governs every scoped_session() read.
# RLS_APP_ROLE is the non-superuser Postgres role RLS policies apply to;
# scoped_session refuses to run if it is empty rather than failing open.
# init_aurora_schema.py creates it from examples/rls_app_role.sql.
# RLS_APP_ROLE=meridian_app
# Escape hatch for local admin diagnostics ONLY: runs queries unscoped, which
# bypasses traveler isolation. It is rejected unless ENVIRONMENT=development.
# Leave unset for the demo and in production.
# RLS_ALLOW_UNSCOPED_FALLBACK=0

# Demo traveler bound to the authenticated workload grant (Phases 4-5).
# MERIDIAN_DEMO_TRAVELER_ID=trv_meridian_demo

# Length in minutes of the courtesy hold the Phase 5 workflow requests.
# MERIDIAN_HOLD_MINUTES=15

# scripts/kill_and_resume_proof.py only: traveler for the proof thread and the
# worker lease length in seconds (must outlast a cold worker's first heartbeat).
# DEMO_TRAVELER_ID=trv_meridian_demo
# DEMO_LEASE_SECONDS=20

# scripts/published.py only: JSON object {"username": ..., "password": ...} for an
# authenticated reachability check of the hosted URL. Export it in your shell; do
# not store credentials in this file.
# MERIDIAN_HOSTED_AUTH=

# Phase 4 hold governance. The backend reads the traveler's saved budget fact
# under RLS and passes a per-trip ceiling in cents to the runtime; the gateway's
# Cedar policy permits a courtesy hold only within it. This default applies
# when the traveler has no budget fact.
# MERIDIAN_DEFAULT_BUDGET_CEILING_CENTS=400000

# PostgreSQL MCP server (Phase 2). Read-only by default — the concierge only
# needs SELECT, so leave MCP_ALLOW_WRITE false unless you are demoing writes.
# MCP_ALLOW_WRITE=false
# MCP_CONNECTION_METHOD=rdsapi
# MCP_DATABASE_TYPE=APG
# MCP_CONCIERGE_LOG_LEVEL=WARNING
# MCP_MEMORY_AGENT_TYPE=memory_agent
# MCP_MEMORY_LOG_LEVEL=WARNING

# FastAPI service binding
# HOST and PORT apply to `python backend/main.py` (default 127.0.0.1:8000).
# backend/launch.py binds 0.0.0.0 and reads only PORT (default 8000). The documented
# uvicorn commands pass --host and --port (8013) and ignore both.
# HOST=127.0.0.1
# PORT=8000
# DEBUG=false
# ENVIRONMENT=development
# Browser/API caller authentication. Local loopback is permitted only in
# development. Set a strong token for a trusted BFF or command-line client
# before exposing the API on any network. Never ship it in Vite build output.
# Cognito sign-in: all three or none, written by scripts/sync_cognito_env.py --write
# after the identity stack is deployed. When set, the API also accepts a verified Cognito
# access token and takes the traveler from its traveler_id claim.
# MERIDIAN_COGNITO_REGION=
# MERIDIAN_COGNITO_USER_POOL_ID=
# MERIDIAN_COGNITO_APP_CLIENT_ID=
# MERIDIAN_API_TOKEN=
# MERIDIAN_API_TRAVELER_ID=trv_meridian_demo
# MERIDIAN_ALLOW_INSECURE_LOCALHOST=true
# Comma-separated explicit allowed origins. Empty allows localhost/127.0.0.1
# only; wildcard origins are rejected.
# CORS_ORIGINS=

# Logging
LOG_LEVEL=INFO
# Emit agent / tool / skill detail on every chat turn (set false to quiet logs)
LOG_AGENT_VERBOSE=true
# LOG_JSON=false
SQL_ECHO=false

# Orchestration — Phase 3/4 use live Strands + Bedrock tool routing (no procedural fallback).
# STRANDS_ORCHESTRATION=full

# Bedrock AgentCore: Phase 4 (required: Runtime + Gateway + Memory)
# See docs/AGENTCORE_DEPLOY_RUNBOOK.md for the full sequence.
#
#   npm install -g @aws/agentcore
#   python scripts/render_agentcore_config.py   # fills the AgentCore templates from this file
#   cd meridian_agentcore && agentcore deploy -y
#   cd .. && python scripts/sync_agentcore_env.py --write
#
# Resource IDs auto-load from meridian_agentcore/agentcore/.cli/deployed-state.json
# AGENTCORE_PROJECT_DIR=/absolute/path/to/meridian/meridian_agentcore   # optional override
# AGENTCORE_SKIP_CLI_SYNC=1                  # skip `agentcore status --json` subprocess
# AGENTCORE_REGION=us-east-1
#
# Manual overrides (optional — env wins over CLI state):
# AGENTCORE_RUNTIME_ARN=
# ARN of the MeridianWorkflow Runtime that runs Phase 5; sync_agentcore_env.py --write sets it
# AGENTCORE_WORKFLOW_RUNTIME_ARN=
# AGENTCORE_GATEWAY_URL=
# AGENTCORE_MEMORY_ID=
# AGENTCORE_WORKLOAD_IDENTITY=
# AGENTCORE_RESOURCE_PROVIDER=
# AGENTCORE_RUNTIME_QUALIFIER=DEFAULT
#
# Short-lived tokens — normally minted at runtime by the Identity provider.
# Set them only to bypass token exchange while debugging locally, and never
# commit real values.
# AGENTCORE_WORKLOAD_TOKEN=
# AGENTCORE_GATEWAY_ACCESS_TOKEN=
