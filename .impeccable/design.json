  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "description": "Filled action used by the featured trip; theme variables select its palette.",
      "html": "<button class=\"ds-primary\" type=\"button\">Explore this trip<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:10px 14px;border:0;border-radius:6px;background:var(--mc-action,#2358ae);color:var(--mc-on-action,#f8faff);font-size:calc(12px * var(--mc-type-scale,1.18));font-weight:600;cursor:pointer;}.ds-primary:focus-visible{outline:2px solid var(--mc-accent,#2457a7);outline-offset:4px;}.ds-primary:disabled{opacity:.55;cursor:wait;}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color 160ms ease-out,color 160ms ease-out;}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Text action",
      "kind": "button",
      "description": "A quieter route to a secondary task.",
      "html": "<button class=\"ds-text\" type=\"button\">Explore more<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:9px 0;border:0;background:none;color:var(--mc-accent,#2457a7);font-size:calc(12px * var(--mc-type-scale,1.18));font-weight:550;cursor:pointer;}.ds-text:focus-visible{outline:2px solid var(--mc-accent,#2457a7);outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-text{transition:background-color 160ms ease-out,color 160ms ease-out;}}",
      "refersTo": "button-text"
    },
    {
      "name": "Save trip",
      "kind": "button",
      "description": "Stable light circular control on photography, with a pressed heart state.",
      "html": "<button class=\"ds-save\" type=\"button\" aria-label=\"Save trip\" aria-pressed=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78Z\"/></svg></button>",
      "css": ".ds-save{display:grid;place-items:center;width:36px;height:36px;border:0;border-radius:50%;background:#f8faff;color:#233c5e;cursor:pointer;}.ds-save:hover,.ds-save[aria-pressed=\"true\"]{background:#dceaff;color:#1d52a5;}.ds-save[aria-pressed=\"true\"] svg{fill:currentColor;}.ds-save:focus-visible{outline:2px solid var(--mc-accent,#2457a7);outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-save{transition:background-color 160ms ease-out,color 160ms ease-out;}}"
    },
    {
      "name": "Conversation composer",
      "kind": "input",
      "description": "The flexible request field and its distinct send action.",
      "html": "<form class=\"ds-composer\"><input class=\"ds-request\" aria-label=\"Travel request\" placeholder=\"Where would you like to go?\"/><button class=\"ds-send\" type=\"button\" aria-label=\"Send request\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></form>",
      "css": ".ds-composer{display:flex;align-items:center;gap:13px;padding:8px 10px 8px 16px;min-height:62px;background:var(--mc-soft,#edf1f7);border:1px solid var(--mc-line,#dce3ed);border-radius:10px;}.ds-request{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);min-width:0;width:100%;color:var(--mc-ink,#152640);background:none;border:0;font-size:calc(14px * var(--mc-type-scale,1.18));padding:6px 0;caret-color:var(--mc-accent,#2457a7);}.ds-request::placeholder{color:var(--mc-muted,#566780);opacity:1;}.ds-send{display:grid;place-items:center;width:40px;height:40px;flex-shrink:0;border:0;border-radius:7px;background:var(--mc-action,#2358ae);color:var(--mc-on-action,#f8faff);}.ds-send:disabled{background:var(--mc-line,#dce3ed);color:var(--mc-muted,#566780);opacity:1;}@media(max-width:860px){.ds-request{font-size:calc(16px * var(--mc-type-scale,1.04));}}",
      "refersTo": "composer"
    },
    {
      "name": "Service navigation",
      "kind": "nav",
      "description": "The navy service rail maintains the same colors in both themes.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Meridian services\"><button class=\"ds-nav-item ds-active\" type=\"button\" aria-current=\"page\">Concierge</button><button class=\"ds-nav-item\" type=\"button\">Trips</button><button class=\"ds-nav-item\" type=\"button\">Discover</button></nav>",
      "css": ".ds-nav{display:grid;gap:4px;padding:12px;background:#10213c;}.ds-nav-item{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);text-align:left;min-height:44px;border:0;border-radius:7px;background:transparent;color:#afc1db;font-size:calc(13px * var(--mc-type-scale,1.18));font-weight:500;cursor:pointer;}.ds-nav-item.ds-active{background:#23436a;color:#f4f7ff;}.ds-nav-item:hover{background:#1a3458;color:#f4f7ff;}.ds-nav-item:focus-visible{outline:2px solid var(--mc-accent,#2457a7);outline-offset:4px;}",
      "refersTo": "navigation"
    },
    {
      "name": "Suggested prompt",
      "kind": "chip",
      "description": "A concise operable prompt above the composer.",
      "html": "<button class=\"ds-chip\" type=\"button\">A relaxing trip</button>",
      "css": ".ds-chip{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);min-height:30px;padding:6px 10px;border:1px solid var(--mc-line,#dce3ed);border-radius:5px;background:none;color:var(--mc-ink,#152640);font-size:calc(11px * var(--mc-type-scale,1.18));cursor:pointer;}",
      "refersTo": "prompt-chip"
    },
    {
      "name": "Travel brief",
      "kind": "card",
      "description": "Quiet grouped facts in the same surface and type language as the traveler rail.",
      "html": "<section class=\"ds-brief\"><h2>Your travel brief</h2><dl><div><dt>Travel dates</dt><dd>Open to ideas</dd></div><div><dt>Usual budget</dt><dd>Not set</dd></div></dl></section>",
      "css": ".ds-brief{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);padding:24px;background:var(--mc-surface,#ffffff);color:var(--mc-ink,#152640);border-radius:12px;}.ds-brief h2{margin:0 0 22px;font-size:calc(16px * var(--mc-type-scale,1.18));font-weight:570;}.ds-brief dl{display:grid;gap:17px;margin:0;}.ds-brief dl>div{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}.ds-brief dt{color:var(--mc-muted,#566780);font-size:calc(12px * var(--mc-type-scale,1.18));}.ds-brief dd{margin:0;max-width:60%;text-align:right;font-size:calc(12px * var(--mc-type-scale,1.18));font-weight:550;}",
      "refersTo": "card"
    },
    {
      "name": "Caution notice",
      "kind": "custom",
      "description": "Explicit status language accompanies the warm caution colors.",
      "html": "<div class=\"ds-caution\" role=\"status\"><strong>Flight canceled. Your journey doesn\u2019t end here.</strong><p>We\u2019ll work through the alternatives and keep your preferences in the plan.</p></div>",
      "css": ".ds-caution{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);padding:18px 21px;border-radius:9px;color:var(--mc-caution,#80551d);background:var(--mc-caution-bg,#fbf2e4);}.ds-caution strong{font-size:calc(15px * var(--mc-type-scale,1.18));font-weight:600;}.ds-caution p{font-size:calc(12px * var(--mc-type-scale,1.18));margin:6px 0 0;line-height:1.5;}"
    },
    {
      "name": "Observed-state fact",
      "kind": "custom",
      "description": "Evidence preserves a readable label and shows missing data explicitly.",
      "html": "<div class=\"ds-fact\"><span class=\"ds-fact-label\">Hold records</span><span class=\"ds-fact-value\">\u2014</span></div>",
      "css": ".ds-fact{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:grid;gap:8px;color:var(--mc-ink,#152640);}.ds-fact-label{color:var(--mc-muted,#566780);font-size:max(16px,calc(14px * var(--mc-type-scale,1.18)));}.ds-fact-value{font-size:calc(20px * var(--mc-type-scale,1.18));overflow-wrap:anywhere;}"
    },
    {
      "name": "Architecture and evidence disclosure",
      "kind": "custom",
      "description": "Each capability phase has one takeaway and sentence; this native disclosure keeps supporting architecture closed initially.",
      "html": "<details class=\"ds-details\"><summary>Architecture &amp; evidence <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><dl><div><dt>Technology</dt><dd>LangGraph \u00b7 Aurora PostgreSQL</dd></div><div><dt>Verify in the trace</dt><dd>Checkpoint, thread ID, and resume result</dd></div></dl></details>",
      "css": ".ds-details{font-family:var(--mds-font,\"Geist Variable\",ui-sans-serif,sans-serif);color:var(--mc-ink,#152640);}.ds-details summary{display:flex;align-items:center;gap:12px;width:fit-content;min-height:44px;list-style:none;cursor:pointer;color:var(--mc-accent,#2457a7);font-size:calc(13px * var(--mc-type-scale,1.18));font-weight:550;}.ds-details summary::-webkit-details-marker{display:none;}.ds-details[open] summary svg{transform:rotate(180deg);}.ds-details summary:focus-visible{outline:2px solid var(--mc-accent,#2457a7);outline-offset:4px;border-radius:4px;}.ds-details dl{display:grid;gap:12px;margin:0;font-size:calc(13px * var(--mc-type-scale,1.18));line-height:1.6;}.ds-details dl>div{display:grid;grid-template-columns:150px 1fr;gap:14px;}.ds-details dt{color:var(--mc-muted,#566780);}.ds-details dd{margin:0;}@media(max-width:860px){.ds-details dl>div{grid-template-columns:1fr;gap:3px;}}"
    }
  ],
  "narrative": {
    "northStar": "Capable airline service",
    "overview": "Meridian pairs calm navy navigation with cool silver and white task surfaces, useful destination photography, and clear travel details. The user's United Airlines and Delta Airlines references establish the level of service polish. Meridian keeps its own name, assets, and palette.\n\nThe interface is a working travel application: readable facts, a useful next action, and the traveler's returned preferences establish confidence. The dark theme carries the same hierarchy and component language. Presenter evidence uses this shared system while making observed state and missing evidence explicit.",
    "keyCharacteristics": [
      "Navy service navigation and blue actions anchor both themes.",
      "Geist variable type supports readable travel details and presentation use.",
      "Real destination photography gives travel content its visual identity.",
      "Tonal surfaces, fine borders, and modest corners organize the work.",
      "State labels distinguish saved progress, loading, missing evidence, and reported disruption."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Use the semantic theme roles together. Keep the navy service navigation stable while changing the canvas, reading colors, borders, accents, and caution treatments as a complete set.",
        "section": "colors"
      },
      {
        "name": "The Projector Rule",
        "body": "The current desktop scale is (1.18); at widths up to (860px) the compact scale is (1.04). Preserve the evidence-label minimum when adjusting the scale. Small incidental captions in older code are not a target for new information that the audience must read.",
        "section": "typography"
      },
      {
        "name": "The Task Surface Rule",
        "body": "Use a tonal change or a fine dividing line to separate adjacent work. Add visual weight in proportion to the task's importance, with the primary action and the useful travel content leading.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared semantic color pairs in both themes.",
      "Do make travel facts, the next action, and returned preferences easy to read.",
      "Do use the bundled destination photographs and established icon language.",
      "Do preserve visible keyboard focus, explicit action names, and compact layout flow.",
      "Do distinguish reported disruption, saved workflow state, observed evidence, and missing data.",
      "Do retain projector scaling and the minimum size for essential evidence metadata."
    ],
    "donts": [
      "Don't turn the airline references into invented partnerships or airline-issued documents.",
      "Don't make sample catalog content look like a live airline booking or ticket feed.",
      "Don't replace missing flight, seat, preference, or execution data with fabricated facts.",
      "Don't promote decorative glows, heavy framing, or unrelated legacy palettes into new surfaces.",
      "Don't make technical implementation detail compete with the traveler's immediate task."
    ]
  }
}
